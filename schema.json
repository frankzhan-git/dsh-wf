{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/ui-layout-node.json",
  "title": "UI 布局语义描述节点（JSONL 单行）",
  "description": "对应《UI布局语义描述标准（JSONL格式，纯净版）》的单行节点校验 Schema。一个 JSONL 文件的每一行都应满足本 Schema。",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "description": "节点类型（page=页面/设计稿根节点，container=容器，其余为基础元素）",
      "enum": [
        "page", "container", "text", "button", "input", "textarea", "image", "video",
        "audio", "icon", "link", "select", "checkbox", "radio", "switch",
        "progress", "divider", "badge"
      ]
    },
    "name": { "description": "元素标识名称，如「保存按钮」", "type": "string" },
    "description": { "description": "辅助说明：用途、交互或业务含义", "type": "string" },
    "props": {
      "description": "元素专属属性，由 type 决定内容",
      "$ref": "#/$defs/props"
    },
    "children": {
      "description": "子节点数组（仅容器类型有意义）",
      "type": "array",
      "items": { "$ref": "#" }
    },
    "direction": {
      "description": "容器排列方向，默认 vertical",
      "enum": ["horizontal", "vertical"]
    },
    "wrap": {
      "description": "是否允许换行/换列实现流式布局，默认 false",
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "props": {
      "description": "所有类型通用 props 的并集；具体类型只使用其中相关字段",
      "type": "object",
      "properties": {
        "text": { "description": "文本内容 / 按钮文字 / 链接文字 / 徽标文字", "type": "string" },
        "action": { "description": "点击动作描述（button）", "type": "string" },
        "placeholder": { "description": "占位提示（input/textarea）", "type": "string" },
        "value": { "description": "默认值 / 进度值 / 选中值（input/textarea/select/radio/progress）" },
        "inputType": {
          "description": "输入类型（input），避免与节点 type 字段混淆",
          "type": "string",
          "enum": ["text", "number", "password", "email", "tel", "url", "search", "date", "time"]
        },
        "rows": { "description": "行数（textarea）", "type": "integer", "minimum": 1 },
        "src": { "description": "地址（image/video/audio）", "type": "string" },
        "alt": { "description": "替代文本（image）", "type": "string" },
        "poster": { "description": "封面图（video）", "type": "string" },
        "autoplay": { "description": "是否自动播放（video）", "type": "boolean" },
        "controls": { "description": "是否显示控制条（audio）", "type": "boolean" },
        "name": { "description": "图标名称（icon）", "type": "string" },
        "size": { "description": "尺寸（icon）", "type": "number" },
        "href": { "description": "链接地址（link）", "type": "string" },
        "options": {
          "description": "选项数组（select）：字符串或 {label, value} 对象",
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "value": {}
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "label": { "description": "标签文字（checkbox）", "type": "string" },
        "checked": { "description": "是否选中/打开（checkbox/radio/switch）", "type": "boolean" },
        "max": { "description": "最大值（progress）", "type": "number" },
        "columns": { "description": "网格列数（container 网格效果）", "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
